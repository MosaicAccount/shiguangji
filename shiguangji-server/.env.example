# 复制后由 shell、IDE 或部署平台注入；Spring Boot 不会自动读取本文件。
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=18080

MYSQL_URL='jdbc:mysql://localhost:13306/shiguangji?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=GMT%2B8'
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_DATABASE=0
REDIS_PASSWORD=

JWT_SECRET=replace-with-a-local-secret-at-least-32-characters
SGJ_UPLOAD_PATH=/tmp/shiguangji/uploadPath
