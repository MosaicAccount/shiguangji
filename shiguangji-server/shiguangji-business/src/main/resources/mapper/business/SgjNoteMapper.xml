<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shiguangji.business.mapper.SgjNoteMapper">

    <resultMap type="SgjNote" id="SgjNoteResult">
        <result property="noteId"      column="note_id"      />
        <result property="itemId"      column="item_id"      />
        <result property="itemName"    column="item_name"    />
        <result property="title"       column="title"        />
        <result property="content"     column="content"      />
        <result property="tags"        column="tags"         />
        <result property="isPublic"    column="is_public"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <!-- 左联条目表带出关联条目名称（条目软删后仍回显名称） -->
    <sql id="selectSgjNoteVo">
        select n.note_id, n.item_id, n.title, n.content, n.tags, n.is_public,
               n.create_by, n.create_time, n.update_by, n.update_time, n.remark,
               i.title as item_name
        from sgj_note n
        left join sgj_item i on i.item_id = n.item_id
    </sql>

    <!-- 前台列表条件与后台完全一致（复用过滤逻辑，不含 order by） -->
    <sql id="frontWhere">
        <where>
            n.del_flag = '0'
            <if test="createBy != null and createBy != ''">
                and n.create_by = #{createBy}
            </if>
            <if test="itemId != null">
                and n.item_id = #{itemId}
            </if>
            <if test="isPublic != null and isPublic != ''">
                and n.is_public = #{isPublic}
            </if>
            <if test="title != null and title != ''">
                and n.title like concat('%', #{title}, '%')
            </if>
            <!-- 标题+正文全文检索：布尔模式（自然语言模式会把 mysql 命中到只含 sql 的行）；
                 标题与正文在同一 match 条件里，无 or，不会短路 create_by/is_public 等过滤；
                 布尔运算符已在服务层剔除。回收站不纳入（见 selectRecycleNoteList） -->
            <if test="keyword != null and keyword != ''">
                and match(n.title, n.content) against(#{keyword} in boolean mode)
            </if>
            <!-- FIND_IN_SET 按逗号分段完整匹配，避免子串误命中；replace 兼容手输期的“逗号+空格”写法 -->
            <if test="tags != null and tags != ''">
                and find_in_set(#{tags}, replace(n.tags, ' ', ''))
            </if>
        </where>
    </sql>

    <!-- YAML 前言（front-matter）结束位置：正文从其之后开始（导入的 md 普遍带前言，
         不跳过会进摘要与命中定位）。开场为单独一行三个连字符，找首个换行加三连字符作闭合；
         找不到闭合按无前言处理。MySQL 字符串串接 '\n' 依赖反斜杠转义（默认 sql_mode）
         详情页那份同款规则在 Java：SgjNoteServiceImpl.buildBody（列表不下发正文，两份须同步改） -->
    <sql id="fmEnd">
        if(left(n.content, 4) in ('---\n', '---\r'),
           coalesce(nullif(locate('\n---', n.content), 0) + 5, 1),
           1)
    </sql>

    <select id="selectSgjNoteById" parameterType="Long" resultMap="SgjNoteResult">
        <include refid="selectSgjNoteVo"/>
        where n.note_id = #{noteId} and n.del_flag = '0'
    </select>

    <select id="selectSgjNoteList" parameterType="SgjNote" resultMap="SgjNoteResult">
        <include refid="selectSgjNoteVo"/>
        <include refid="frontWhere"/>
        order by n.update_time desc, n.note_id desc
    </select>

    <resultMap type="SgjNote" id="SgjNoteFrontResult">
        <result property="noteId"      column="note_id"      />
        <result property="itemId"      column="item_id"      />
        <result property="itemName"    column="item_name"    />
        <result property="title"       column="title"        />
        <result property="tags"        column="tags"         />
        <result property="isPublic"    column="is_public"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="excerptSrc"  column="excerpt_src"  />
        <result property="hitTotal"    column="hit_total"    />
    </resultMap>

    <!-- 前台列表（结论 32）：不取全文，正文与 remark 均不下发。
         摘要片段与命中总数由 selectSgjNoteExcerptFragments 按页内主键补查——
         复杂表达式若放进本查询，PageHelper 生成 count 时的 jsqlparser 解析会灾难性回溯（实测 CPU 卡死），
         故基础查询保持简单列清单。后台列表与导出仍走 selectSgjNoteList / selectSgjNoteVo，带完整正文 -->
    <select id="selectSgjNoteFrontList" parameterType="SgjNote" resultMap="SgjNoteFrontResult">
        select n.note_id, n.item_id, i.title as item_name, n.title, n.tags, n.is_public,
               n.create_by, n.create_time, n.update_by, n.update_time
        from sgj_note n
        left join sgj_item i on i.item_id = n.item_id
        <include refid="frontWhere"/>
        order by n.update_time desc, n.note_id desc
    </select>

    <resultMap type="SgjNote" id="SgjNoteExcerptResult">
        <result property="noteId"      column="note_id"      />
        <result property="excerptSrc"  column="excerpt_src"  />
        <result property="hitTotal"    column="hit_total"    />
    </resultMap>

    <!-- 按页内主键补查摘要片段与命中总数（每页 ≤ pageSize 行，不经分页插件）。
         命中总数统计口径 = 标题 + 去前言正文，并去除与标题重复的首个一级标题行——
         与详情页「标题 + 正文」的高亮所见完全一致：列表次数 = 详情可跳转处数。
         摘要片段：正文首个命中为中心 ±40 字取 200 字符（余量给剥离损耗，Java 再裁）；
         只命中标题（正文内无命中）时回退正文前缀 600 字符；片段外还有正文时由 SQL 拼省略号。
         min_loc 的 foreach 段重复三次（MyBatis 无法给表达式取别名），LEAST 尾部追加哨兵
         2147483647 保证单检索词时也有两个参数（MySQL 的 LEAST 要求至少两参） -->
    <select id="selectSgjNoteExcerptFragments" resultMap="SgjNoteExcerptResult">
        select t.note_id,
               <if test="keywordWords != null and keywordWords.size() > 0">
               <!-- 统计口径见上方注释；h1 行仅匹配「# + 标题」的精确形式，变体（无空格等）按未重复处理 -->
               (<foreach collection="keywordWords" item="w" separator=" + ">
                    (char_length(t.txt) - char_length(replace(t.txt, #{w}, ''))) div char_length(#{w})
                </foreach>) as hit_total,
               </if>
               t.excerpt_src
        from (
            select
                   <if test="keywordWords != null and keywordWords.size() > 0">
                   concat(n.title,
                          if(left(substring(n.content, <include refid="fmEnd"/>),
                                  char_length(concat('# ', n.title, char(10)))) = concat('# ', n.title, char(10)),
                             substring(substring(n.content, <include refid="fmEnd"/>),
                                       char_length(concat('# ', n.title, char(10))) + 1),
                             substring(n.content, <include refid="fmEnd"/>))) as txt,
                   case when least(
                            <foreach collection="keywordWords" item="w" separator=",">
                                ifnull(nullif(locate(#{w}, n.content, <include refid="fmEnd"/>), 0), 2147483647)
                            </foreach>
                            , 2147483647) = 2147483647
                        then concat(substring(n.content, <include refid="fmEnd"/>, 600),
                                    if(char_length(n.content) - <include refid="fmEnd"/> + 1 > 600, '…', ''))
                        else concat(
                            if(least(
                                <foreach collection="keywordWords" item="w" separator=",">
                                    ifnull(nullif(locate(#{w}, n.content, <include refid="fmEnd"/>), 0), 2147483647)
                                </foreach>
                                , 2147483647) > 41, '…', ''),
                            substring(n.content, greatest(1, least(
                                <foreach collection="keywordWords" item="w" separator=",">
                                    ifnull(nullif(locate(#{w}, n.content, <include refid="fmEnd"/>), 0), 2147483647)
                                </foreach>
                                , 2147483647) - 40), 200),
                            if(greatest(1, least(
                                <foreach collection="keywordWords" item="w" separator=",">
                                    ifnull(nullif(locate(#{w}, n.content, <include refid="fmEnd"/>), 0), 2147483647)
                                </foreach>
                                , 2147483647) - 40) + 200 >= char_length(n.content) + 1, '', '…'))
                   end as excerpt_src,
                   </if>
                   <if test="keywordWords == null or keywordWords.size() == 0">
                   concat(substring(n.content, <include refid="fmEnd"/>, 600),
                          if(char_length(n.content) - <include refid="fmEnd"/> + 1 > 600, '…', '')) as excerpt_src,
                   </if>
                   n.note_id
            from sgj_note n
            where n.del_flag = '0'
            and n.note_id in
            <foreach collection="noteIds" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        ) t
    </select>

    <insert id="insertSgjNote" parameterType="SgjNote" useGeneratedKeys="true" keyProperty="noteId">
        insert into sgj_note
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemId != null">item_id,</if>
            title,
            <if test="content != null">content,</if>
            <if test="tags != null and tags != ''">tags,</if>
            <if test="isPublic != null and isPublic != ''">is_public,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="itemId != null">#{itemId},</if>
            #{title},
            <if test="content != null">#{content},</if>
            <if test="tags != null and tags != ''">#{tags},</if>
            <if test="isPublic != null and isPublic != ''">#{isPublic},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateSgjNote" parameterType="SgjNote">
        update sgj_note
        <set>
            item_id = #{itemId},
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="isPublic != null and isPublic != ''">is_public = #{isPublic},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate(),
        </set>
        where note_id = #{noteId} and del_flag = '0'
    </update>

    <select id="selectRecycleNoteList" parameterType="SgjNote" resultMap="SgjNoteResult">
        <include refid="selectSgjNoteVo"/>
        <where>
            n.del_flag = '2'
            <if test="noteId != null">
                and n.note_id = #{noteId}
            </if>
            <if test="createBy != null and createBy != ''">
                and n.create_by = #{createBy}
            </if>
            <if test="title != null and title != ''">
                and n.title like concat('%', #{title}, '%')
            </if>
        </where>
        order by n.update_time desc, n.note_id desc
    </select>

    <!-- 软删除：标记 del_flag = '2' -->
    <update id="deleteSgjNoteById" parameterType="Long">
        update sgj_note set del_flag = '2', update_time = sysdate()
        where note_id = #{noteId} and del_flag = '0'
    </update>

    <update id="deleteSgjNoteByIds" parameterType="Long">
        update sgj_note set del_flag = '2', update_time = sysdate()
        where note_id in
        <foreach item="noteId" collection="array" open="(" separator="," close=")">
            #{noteId}
        </foreach>
        and del_flag = '0'
    </update>

    <!-- 恢复回收站笔记 -->
    <update id="restoreSgjNoteByIds" parameterType="Long">
        update sgj_note set del_flag = '0', update_time = sysdate()
        where note_id in
        <foreach item="noteId" collection="array" open="(" separator="," close=")">
            #{noteId}
        </foreach>
        and del_flag = '2'
    </update>

    <!-- 彻底删除回收站笔记（物理删除） -->
    <delete id="purgeSgjNoteByIds" parameterType="Long">
        delete from sgj_note where note_id in
        <foreach item="noteId" collection="array" open="(" separator="," close=")">
            #{noteId}
        </foreach>
        and del_flag = '2'
    </delete>

</mapper>