<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shiguangji.business.mapper.FileReferenceMapper">

    <!--
      上传文件的全部业务引用来源。新增引用列时必须同步补充，否则对应文件会被误判为孤儿。
      /profile/ 字面量对应 Constants.RESOURCE_PREFIX，与 sys_file.storage_key 及业务列的
      保存格式一致；用 like 同时排除了空串、NULL 与外部图片地址。
    -->
    <select id="selectReferencedStorageKeys" resultType="java.lang.String">
        select cover_url from sgj_item where cover_url like '/profile/%'
        union
        select url from sgj_item_photo where url like '/profile/%'
        union
        select avatar from sys_user where avatar like '/profile/%'
    </select>

    <!--
      正文里的 /profile 引用（笔记 + 草稿，0.0.2 FR-002-9）。正文不是「一列一个文件」，
      只能把可能命中的文本取回来，交给 ProfileRefExtractor 以候选集为字典抽键（设计 结论 55 / 56）。
      union all 不去重：正文可能很长，为去重而比较全文不值当，重复项在抽取结果里自然是同一个键。
      不过滤 del_flag：回收站里的笔记可恢复，其图必须留；草稿没有过期机制，同样要认。
    -->
    <select id="selectContentsWithProfileRefs" resultType="java.lang.String">
        select content from sgj_note where content like '%/profile/%'
        union all
        select content from sgj_note_draft where content like '%/profile/%'
    </select>

</mapper>
