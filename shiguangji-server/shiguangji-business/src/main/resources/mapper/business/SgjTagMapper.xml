<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shiguangji.business.mapper.SgjTagMapper">

    <resultMap type="SgjTag" id="SgjTagResult">
        <result property="tagId"      column="tag_id"      />
        <result property="module"     column="module"      />
        <result property="tagName"    column="tag_name"    />
        <result property="sort"       column="sort"        />
        <result property="status"     column="status"      />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
    </resultMap>

    <sql id="selectSgjTagVo">
        select tag_id, module, tag_name, sort, status,
               create_by, create_time, update_by, update_time, remark
        from sgj_tag
    </sql>

    <select id="selectSgjTagById" parameterType="Long" resultMap="SgjTagResult">
        <include refid="selectSgjTagVo"/>
        where tag_id = #{tagId} and del_flag = '0'
    </select>

    <select id="selectSgjTagList" parameterType="SgjTag" resultMap="SgjTagResult">
        <include refid="selectSgjTagVo"/>
        <where>
            del_flag = '0'
            <if test="module != null and module != ''">
                and module = #{module}
            </if>
            <if test="tagName != null and tagName != ''">
                and tag_name like concat('%', #{tagName}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by sort asc, tag_id asc
    </select>

    <select id="selectSgjTagByModuleAndName" parameterType="SgjTag" resultMap="SgjTagResult">
        <include refid="selectSgjTagVo"/>
        where module = #{module} and tag_name = #{tagName} and del_flag = '0'
    </select>

    <insert id="insertSgjTag" parameterType="SgjTag" useGeneratedKeys="true" keyProperty="tagId">
        insert into sgj_tag
        <trim prefix="(" suffix=")" suffixOverrides=",">
            module,
            tag_name,
            <if test="sort != null">sort,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            #{module},
            #{tagName},
            <if test="sort != null">#{sort},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateSgjTag" parameterType="SgjTag">
        update sgj_tag
        <set>
            module = #{module},
            tag_name = #{tagName},
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate(),
        </set>
        where tag_id = #{tagId} and del_flag = '0'
    </update>

    <!-- 软删除：仅删除标签定义，已引用该标签的记录保留原文 -->
    <update id="deleteSgjTagByIds" parameterType="Long">
        update sgj_tag set del_flag = '2', update_time = sysdate()
        where tag_id in
        <foreach item="tagId" collection="array" open="(" separator="," close=")">
            #{tagId}
        </foreach>
        and del_flag = '0'
    </update>

</mapper>
